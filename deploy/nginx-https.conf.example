# CHS-DRG MCP Server —— Nginx HTTPS 反向代理示例
#
# 用法：
#   1) 复制到 /etc/nginx/conf.d/chs-drg-mcp.conf
#   2) 替换 mcp.example.com 为你的域名、替换证书路径
#   3) nginx -t && systemctl reload nginx
#
# 证书：云厂商免费 DV 证书，或 certbot --nginx -d mcp.example.com
# 关键：SSE 是长连接，必须关闭缓冲，并拉长超时。

upstream chs_drg_mcp {
    server 127.0.0.1:4174;
    keepalive 32;
}

server {
    listen 80;
    server_name mcp.example.com;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    http2 on;
    server_name mcp.example.com;

    ssl_certificate     /etc/nginx/ssl/mcp.example.com.crt;
    ssl_certificate_key /etc/nginx/ssl/mcp.example.com.key;
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_ciphers         HIGH:!aNULL:!MD5;

    # MCP / SSE 关键设置
    proxy_buffering off;
    proxy_cache off;
    proxy_read_timeout 3600s;
    proxy_send_timeout 3600s;
    chunked_transfer_encoding on;

    location ~ ^/(mcp|sse|messages|health)$ {
        proxy_pass http://chs_drg_mcp;
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection        "";
        proxy_set_header Accept-Encoding   "";
    }
}
